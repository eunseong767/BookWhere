<?xml version="1.0" encoding="utf-8"?>
<!-- B3 책 상세 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 상단: 뒤로 + "책 상세" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_detail_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="책 상세"
            android:textSize="18sp"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 불러오기가 끝나면 보임 -->
        <ScrollView
            android:id="@+id/scroll_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- 표지 + 제목 + 저자·분야 + 출판사 (가운데 정렬) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_detail_cover"
                        android:layout_width="136dp"
                        android:layout_height="196dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:importantForAccessibility="noHideDescendants"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/layout_detail_cover_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="16dp">

                            <TextView
                                android:id="@+id/tv_detail_cover_title"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:lineSpacingMultiplier="1.1"
                                android:maxLines="5"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_detail_cover_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_detail_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/background"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <!-- "저자 · 분야" -->
                    <TextView
                        android:id="@+id/tv_detail_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/text_sub" />

                    <!-- "출판사 김영사" -->
                    <TextView
                        android:id="@+id/tv_detail_publisher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_book_description"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_contents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/text_sub"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- 이용 가능한 플랫폼 -->
                <LinearLayout
                    android:id="@+id/layout_detail_platform_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="이용 가능한 플랫폼"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <!-- "5곳 중 2곳" -->
                    <TextView
                        android:id="@+id/tv_detail_platform_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13sp"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 플랫폼 5줄은 DetailActivity에서 item_detail_platform.xml로 채움 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_platforms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/layout_detail_platforms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 어느 구독에도 없을 때만 보임 -->
                <TextView
                    android:id="@+id/tv_detail_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_detail_note"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="16dp"
                    android:text="어느 구독 서비스에도 없는 책이에요. 가까운 도서관에서 빌려 볼 수 있는지 확인해 보세요."
                    android:textSize="15sp"
                    android:textColor="@color/text_main"
                    android:visibility="gone" />

                <!-- 조사하지 않은 책(카카오 검색 결과)일 때만 보임: 조사 요청 -->
                <LinearLayout
                    android:id="@+id/layout_detail_request"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_detail_note"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="구독 정보 준비 중"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="아직 조사하지 않은 책이에요.\n요청이 많은 책부터 확인해 드려요."
                        android:textColor="@color/text_sub"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_detail_request"
                        style="@style/Widget.BookWhere.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="조사 요청하기" />

                    <!-- "N명이 요청했어요" (요청한 뒤에만 보임) -->
                    <TextView
                        android:id="@+id/tv_detail_request_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progress_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />
    </FrameLayout>

    <!-- 하단 찜 버튼 영역 (흰 바탕 + 위쪽 구분선) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nav_bg" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- 찜 안 한 책 -->
        <Button
            android:id="@+id/btn_detail_wish"
            style="@style/Widget.BookWhere.Button"
            android:layout_width="match_parent"
            android:enabled="false"
            android:text="찜하기"
            app:icon="@drawable/ic_heart"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp"
            app:iconTint="@color/surface" />

        <!-- 이미 찜한 책 -->
        <Button
            android:id="@+id/btn_detail_unwish"
            style="@style/Widget.BookWhere.Button.Outlined"
            android:layout_width="match_parent"
            android:text="찜 취소"
            android:visibility="gone"
            app:icon="@drawable/ic_detail_heart_filled"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp"
            app:iconTint="@color/primary" />
    </FrameLayout>
</LinearLayout>
