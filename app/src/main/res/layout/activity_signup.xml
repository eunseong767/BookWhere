<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 상단 뒤로가기 및 타이틀 -->
        <TextView
            android:id="@+id/tv_signup_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="← 로그인으로 돌아가기"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_signup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="회원가입"
            android:textColor="@color/text_main"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_back" />

        <TextView
            android:id="@+id/tv_signup_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="전찾책에서 나만의 전자책 구독을 시작하세요"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_title" />

        <!-- 1. 닉네임 입력 -->
        <TextView
            android:id="@+id/tv_nickname_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="닉네임"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_signup_nickname"
            style="@style/Widget.BookWhere.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_nickname_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_signup_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="사용할 닉네임 입력"
                android:inputType="textPersonName"
                android:paddingVertical="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. 이메일 입력 -->
        <TextView
            android:id="@+id/tv_signup_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="이메일"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_signup_nickname" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_signup_email"
            style="@style/Widget.BookWhere.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_email_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_signup_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingVertical="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. 비밀번호 입력 -->
        <TextView
            android:id="@+id/tv_signup_pw_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="비밀번호"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_signup_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_signup_pw"
            style="@style/Widget.BookWhere.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_pw_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_signup_pw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="6자 이상 입력"
                android:inputType="textPassword"
                android:paddingVertical="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 4. 비밀번호 확인 입력 -->
        <TextView
            android:id="@+id/tv_signup_pw_confirm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="비밀번호 확인"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_signup_pw" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_signup_pw_confirm"
            style="@style/Widget.BookWhere.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_signup_pw_confirm_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_signup_pw_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="비밀번호 다시 입력"
                android:inputType="textPassword"
                android:paddingVertical="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 가입하기 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_signup_submit"
            style="@style/Widget.BookWhere.Button"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="24dp"
            android:text="가입 완료"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_signup_pw_confirm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>