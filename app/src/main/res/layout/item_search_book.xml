<?xml version="1.0" encoding="utf-8"?>
<!-- B2 책 검색 결과 한 칸 (2열 그리드) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="24dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- 표지 대신 색 박스에 제목/저자 (색은 SearchBookAdapter.coverColors) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search_book_cover"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="noHideDescendants"
        app:cardCornerRadius="6dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_search_book_cover_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="5"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_search_book_cover_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 표지 사진 (BookCoverLoader가 받으면 보이고, 없으면 위 색 박스가 보임) -->
        <ImageView
            android:id="@+id/iv_search_book_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_search_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <!-- "저자 · 분야" -->
    <TextView
        android:id="@+id/tv_search_book_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textColor="@color/text_sub" />

    <!-- "3곳에서 이용 가능" / "구독 서비스에 없어요" -->
    <TextView
        android:id="@+id/tv_search_book_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:textSize="13sp" />
</LinearLayout>
